#language GLSL
// 330: TAA + NIS / FSR 1 / CAS'ta keskinleştirmenin geri alındığı geometrik kenar maskesi (Sharpen.cqsh). İç çözünürlükteki derinlik ve
// normalden (derinlik kesintisi, gökyüzü / nesne, normal kıvrımı), pikselin titreşimli iç örnekler arasındaki yerine göre yumuşak. Kamera
// dururken önceki karenin maskesiyle karışır: pikselden ince nesne (hedef direği) titreşimin bazı karelerinde hiçbir derinlik örneğine
// düşmüyor, maske o karelerde değişip direğin çevresi keskin / keskin olmayan arasında titriyordu
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
out vec2 v_UV;
void main()
{
    v_UV = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core
layout(location = 0) out float FragMask;
in vec2 v_UV;
uniform sampler2D u_PrevMask;
uniform int u_UseHistory = 0;      // 1: kamera duruyor ve önceki maske geçerli
uniform float u_HistoryWeight = 0.9;

uniform sampler2D u_EdgeDepth;      // sahne derinliği (iç çözünürlük)
uniform sampler2D u_EdgeNormal;     // sahne normali (iç çözünürlük, xy oktahedral)
uniform int u_HasEdgeNormal = 0;
uniform vec2 u_EdgeNearFar = vec2(0.1, 1000.0);

vec3 EdgeOctDecode(vec2 e)
{
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    if (n.z < 0.0)
        n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

uniform vec2 u_EdgeJitterUV = vec2(0.0);   // sahnenin bu karedeki alt piksel titreşimi (uv)

float EdgeViewZ(float d)
{
    return 2.0 * u_EdgeNearFar.x * u_EdgeNearFar.y / max(u_EdgeNearFar.y + u_EdgeNearFar.x - (d * 2.0 - 1.0) * (u_EdgeNearFar.y - u_EdgeNearFar.x), 1e-6);
}

// İki iç örnek arasında geometrik kenar (0..1): gökyüzü / nesne, derinlik kesintisi ya da normal kıvrımı
float EdgeBetween(ivec2 a, ivec2 b, ivec2 sz)
{
    a = clamp(a, ivec2(0), sz - 1);
    b = clamp(b, ivec2(0), sz - 1);
    float da = texelFetch(u_EdgeDepth, a, 0).r, db = texelFetch(u_EdgeDepth, b, 0).r;
    if ((da >= 1.0) != (db >= 1.0))
        return 1.0;
    if (da >= 1.0)
        return 0.0;
    float za = EdgeViewZ(da), zb = EdgeViewZ(db);
    float e = smoothstep(0.02, 0.06, abs(za - zb) / max(min(za, zb), 1e-3));
    if (u_HasEdgeNormal == 1)
        e = max(e, 1.0 - smoothstep(0.75, 0.9, dot(EdgeOctDecode(texelFetch(u_EdgeNormal, a, 0).xy), EdgeOctDecode(texelFetch(u_EdgeNormal, b, 0).xy))));
    return e;
}

// 0..1: çıktı pikseli geometrik bir kenarın üstünde. Pikselin titreşimli iç örnekler arasındaki yeri (TAAU ile aynı) ve kenar çiftlerinin
// orta noktalarına uzaklığıyla yumuşak: titreşim her karede yeri kaydırdığında maske sıçramaz (sabit 3x3 penceresinde kenara yakın
// pikseller karede bir maskeye girip çıkıyor, keskin / keskin olmayan arasında gidip gelip duran kamerada titriyordu)
float GeometricEdge()
{
    ivec2 sz = textureSize(u_EdgeDepth, 0);
    vec2 p = (v_UV + u_EdgeJitterUV) * vec2(sz) - 0.5;
    ivec2 b = ivec2(floor(p));
    float mask = 0.0;
    for (int y = -1; y <= 2; ++y)
        for (int x = -1; x <= 2; ++x)
        {
            ivec2 t = b + ivec2(x, y);
            if (x < 2)
            {
                float d = length(vec2(t) + vec2(0.5, 0.0) - p);
                if (d < 1.75)
                    mask = max(mask, EdgeBetween(t, t + ivec2(1, 0), sz) * (1.0 - smoothstep(0.75, 1.75, d)));
            }
            if (y < 2)
            {
                float d = length(vec2(t) + vec2(0.0, 0.5) - p);
                if (d < 1.75)
                    mask = max(mask, EdgeBetween(t, t + ivec2(0, 1), sz) * (1.0 - smoothstep(0.75, 1.75, d)));
            }
        }
    return mask;
}

void main()
{
    float m = GeometricEdge();
    if (u_UseHistory == 1)
        m = mix(m, texture(u_PrevMask, v_UV).r, u_HistoryWeight);
    FragMask = m;
}
