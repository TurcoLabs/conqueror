#language GLSL
// TAAU (Temporal Anti-Aliasing Upsampling): sahne iç çözünürlükte alt piksel titreşimiyle çizilir; bu geçiş çıktı
// çözünürlüğünde çalışır. Bu karenin rengi iç çözünürlükteki 3x3 örnekten, her örneğin titreşimli konumunun çıktı pikseline
// uzaklığına göre (Blackman-Harris yaklaşığı) kurulur; geçmiş (çıktı çözünürlüğünde) derinlikten yeniden izdüşümle Catmull-Rom
// örneklenir ve 3x3 komşuluğun YCoCg varyans kutusuna kırpılır. Çıktı pikselinin yakınına bu karede örnek düşmediyse güncelleme
// küçüktür: 16 titreşim karesinde her çıktı pikseli kendi alt piksel konumundaki örneklerle dolar (yükseltme). Ton eşlenmiş LDR.
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
out vec2 v_UV;
void main()
{
    v_UV = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core
layout(location = 0) out vec4 FragColor;
layout(location = 1) out vec4 DebugOut;   // r.TAADebug: pikselin geçmiş yolu renkle (geçmişe yazılmaz, yalnız gösterilir)
in vec2 v_UV;
uniform int u_Debug = 0;

uniform sampler2D u_Current;    // iç çözünürlükte titreşimli kare (LDR)
uniform sampler2D u_History;    // çıktı çözünürlüğünde geçmiş
uniform sampler2D u_Depth;      // iç çözünürlükte derinlik
uniform sampler2D u_Velocity;   // nesne hızları (xy uv; x > 5000: yok)
uniform sampler2D u_GNormal;    // w >= 3.5: bu karede hareket eden opak nesne
uniform int u_HasVelocity = 0;
uniform int u_HasMotionFlag = 0;
uniform int u_HistoryValid = 0;
uniform int u_CameraStill = 0;
uniform mat4 u_InvViewProj;     // titreşimli
uniform mat4 u_PrevViewProj;    // önceki karenin titreşimsiz matrisi
uniform vec2 u_InTexel;         // 1 / iç çözünürlük
uniform vec2 u_OutTexel;        // 1 / çıktı çözünürlüğü
uniform vec2 u_JitterUV;        // bu karenin titreşimi (uv)
uniform float u_Feedback = 0.92;
uniform sampler2D u_Reactive;   // parçacık / saydam hareketli nesne maskesi (iç çözünürlükte)
uniform vec3 u_CameraPos;      // kameranın bu ve önceki karedeki konumu (dünya)
uniform vec3 u_PrevCameraPos;
uniform int u_HasReactive = 0;
uniform sampler2D u_PrevDepth;  // önceki karenin derinliği (iç çözünürlük, titreşimli)
uniform int u_HasPrevDepth = 0;
uniform mat4 u_PrevInvViewProj; // önceki karenin titreşimsiz ters görüş-izdüşümü
uniform mat4 u_ViewProjNow;     // bu karenin titreşimsiz görüş-izdüşümü
uniform float u_ProjScale = 1.0; // bu karenin odak uzaklığı / önceki karenin (görüş açısı daralınca > 1)
uniform vec4 u_ShadowBoxes[64];   // 324: hareket eden gölge düşürücülerin dünya kutuları (bu + önceki kare): [2i] min, [2i+1] max
uniform int u_ShadowBoxCount = 0;
uniform vec3 u_TowardSun = vec3(0.0, 1.0, 0.0);

// Dünya noktası hareket eden bir nesnenin gölge hacminde mi (TAA ile aynı): noktadan güneşe giden ışın kutulardan birine çarpıyor mu
bool InMovingShadow(vec3 p)
{
    vec3 dir = u_TowardSun;
    dir = mix(dir, vec3(1e-6), lessThan(abs(dir), vec3(1e-6)));
    vec3 inv = 1.0 / dir;
    for (int i = 0; i < u_ShadowBoxCount; ++i)
    {
        vec3 t1 = (u_ShadowBoxes[2 * i].xyz - p) * inv;
        vec3 t2 = (u_ShadowBoxes[2 * i + 1].xyz - p) * inv;
        vec3 tn = min(t1, t2), tf = max(t1, t2);
        float tNear = max(max(tn.x, tn.y), max(tn.z, 0.0));
        float tFar = min(min(tf.x, tf.y), tf.z);
        if (tFar >= tNear)
            return true;
    }
    return false;
}

// Derinlik değerinden görüş uzaklığı (izdüşümün yakın / uzak düzlemine bağlı; konumdan bağımsız)
float ViewW(vec2 uv, float depth)
{
    vec4 w = u_InvViewProj * vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    return 1.0 / max(abs(w.w), 1e-8);
}

// Açılma: pikselin kendi noktası (titreşimsiz konumu uv, derinliği depth, önceki karedeki yeri prevUV, uzaklığı prevW) önceki karede
// belirgin daha yakın bir yüzeyin arkasındaydı (önceki derinliğin 2x2 ayak izinin en uzağı bile yakın) ve o yüzey bu karede bu noktaya
// göre en az bir iç piksel uzaklaştı. Geçmiş o örtücünün rengidir (küpün arkasından açılan duvarda mavi iz). Duvar üstü ile gökyüzü
// gibi aynı kalan kenarın baş sallanmasıyla oynaması (piksel altı) açılma sayılmaz. Dönen değer örtücünün bu noktaya göre kayması (iç
// piksel; örtücü yoksa -1), occW örtücünün uzaklığı
float RevealShift(vec2 uv, vec2 prevUV, float prevW, vec2 inSize, out float occW)
{
    occW = 1e9;
    if (u_HasPrevDepth == 0 || u_CameraStill == 1 || any(lessThan(prevUV, vec2(0.0))) || any(greaterThan(prevUV, vec2(1.0))))
        return -1.0;
    ivec2 psz = textureSize(u_PrevDepth, 0);
    vec2 pp = prevUV * vec2(psz) - 0.5;
    ivec2 p0 = ivec2(floor(pp));
    float dmax = 0.0;
    for (int j = 0; j <= 1; ++j)
    for (int i = 0; i <= 1; ++i)
        dmax = max(dmax, texelFetch(u_PrevDepth, clamp(p0 + ivec2(i, j), ivec2(0), psz - 1), 0).r);
    occW = ViewW(prevUV, dmax);
    if (dmax >= 1.0 || occW >= prevW * 0.85 - 0.05)
        return -1.0;
    // Örtücünün o noktası (önceki karedeki yeri) bu karede nerede (duran yüzey varsayımı)
    float dq = texelFetch(u_PrevDepth, clamp(ivec2(prevUV * vec2(psz)), ivec2(0), psz - 1), 0).r;
    vec4 q = u_PrevInvViewProj * vec4(prevUV * 2.0 - 1.0, dq * 2.0 - 1.0, 1.0);
    q /= q.w;
    vec4 qn = u_ViewProjNow * q;
    if (qn.w <= 0.0)
        return 1e3;
    vec2 quv = qn.xy / qn.w * 0.5 + 0.5;
    return length((quv - uv) * inSize);
}

vec3 RGBToYCoCg(vec3 c) { return vec3(dot(c, vec3(0.25, 0.5, 0.25)), dot(c, vec3(0.5, 0.0, -0.5)), dot(c, vec3(-0.25, 0.5, -0.25))); }
vec3 YCoCgToRGB(vec3 c) { return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

// Catmull-Rom (9 çift doğrusal dokunuşla 16 texel), halka önleme için sonuç 2x2 texel aralığına sınırlı
vec3 SampleHistory(vec2 uv)
{
    vec2 size = 1.0 / u_OutTexel;
    vec2 pos = uv * size;
    vec2 c = floor(pos - 0.5) + 0.5;
    vec2 f = pos - c;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 t0 = (c - 1.0) * u_OutTexel;
    vec2 t3 = (c + 2.0) * u_OutTexel;
    vec2 t12 = (c + w2 / w12) * u_OutTexel;
    vec3 r = texture(u_History, vec2(t12.x, t0.y)).rgb * (w12.x * w0.y)
           + texture(u_History, vec2(t0.x, t12.y)).rgb * (w0.x * w12.y)
           + texture(u_History, vec2(t12.x, t12.y)).rgb * (w12.x * w12.y)
           + texture(u_History, vec2(t3.x, t12.y)).rgb * (w3.x * w12.y)
           + texture(u_History, vec2(t12.x, t3.y)).rgb * (w12.x * w3.y);
    float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    r /= max(wsum, 1e-4);
    vec3 a = texture(u_History, (c + vec2(0.0, 0.0)) * u_OutTexel).rgb;
    vec3 b = texture(u_History, (c + vec2(1.0, 0.0)) * u_OutTexel).rgb;
    vec3 d = texture(u_History, (c + vec2(0.0, 1.0)) * u_OutTexel).rgb;
    vec3 e = texture(u_History, (c + vec2(1.0, 1.0)) * u_OutTexel).rgb;
    return clamp(r, min(min(a, b), min(d, e)), max(max(a, b), max(d, e)));
}

void main()
{
    vec2 inSize = 1.0 / u_InTexel;
    ivec2 inMax = ivec2(inSize) - 1;
    // Çıktı pikselinin merkezi bu karenin titreşimli iç çözünürlük koordinatlarında (texel merkezleri tam sayı)
    vec2 inPos = (v_UV + u_JitterUV) * inSize - 0.5;
    ivec2 base = ivec2(floor(inPos + 0.5));
    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    float wmax = 0.0;
    vec3 sumN = vec3(0.0);      // dar süzgeç (kamera dururken: biriken ayrıntı keskin)
    float wsumN = 0.0;
    float wmaxN = 0.0;
    bool skyNear = false;       // 3x3'te gökyüzü: siluet kenarı (duvar üstü / gökyüzü)
    vec3 mn = vec3(1e9), mx = vec3(-1e9), m1 = vec3(0.0), m2 = vec3(0.0);
    float closest = 1.0;
    ivec2 closestTex = clamp(base, ivec2(0), inMax);
    float farthest = 0.0;       // 3x3'ün en uzak (gökyüzü dışı) derinliği: kenar paralaksı için
    ivec2 farTex = closestTex;
    bool moving = false;
    float movDepth = 1.0;       // 3x3'te hareket bayraklı (hareket eden nesne) örneklerin en yakını (309: temas kenarı)
    ivec2 movTex = closestTex;
    // Pikselin kendi noktası: çıktı pikseline en yakın iç örnek. Aynı yüzeyin örnekleri (uzaklığı bu noktanınkine yakın) ayrı
    // aralıkta toplanır: açılan pikselin geçmişi yalnız kendi yüzeyinin renklerine kırpılır
    ivec2 cTex = clamp(base, ivec2(0), inMax);
    float cDepth = texelFetch(u_Depth, cTex, 0).r;
    vec2 cUV = (vec2(cTex) + 0.5) * u_InTexel;
    float cW = ViewW(cUV, cDepth);
    vec3 sMin = vec3(1e9), sMax = vec3(-1e9);
    for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x)
    {
        ivec2 t = clamp(base + ivec2(x, y), ivec2(0), inMax);
        vec3 c = max(texelFetch(u_Current, t, 0).rgb, vec3(0.0));
        {
            float sd = texelFetch(u_Depth, t, 0).r;
            bool same = cDepth >= 1.0 ? sd >= 1.0 : (sd < 1.0 && abs(ViewW((vec2(t) + 0.5) * u_InTexel, sd) - cW) < 0.05 * cW + 0.02);
            if (same)
            {
                sMin = min(sMin, RGBToYCoCg(c));
                sMax = max(sMax, RGBToYCoCg(c));
            }
        }
        // Uzaklık çıktı pikseli biriminde (iç piksel / ölçek): süzgeç çıktı pikselinde dar kalır, ayrıntı titreşim döngüsünde birikir
        vec2 d = (vec2(t) - inPos) * (u_InTexel / u_OutTexel);
        // Hareket ederken Blackman-Harris yaklaşığı (kenarlar her karede yumuşak kalır); dururken dar süzgeç: geniş süzgeç her
        // örneği komşu çıktı piksellerine yayıp birikmiş yükseltmeyi bulanıklaştırıyordu
        float w = exp(-2.7 * dot(d, d));
        sum += c * w;
        wsum += w;
        wmax = max(wmax, w);
        float wn = exp(-3.2 * dot(d, d));
        sumN += c * wn;
        wsumN += wn;
        wmaxN = max(wmaxN, wn);
        vec3 yc = RGBToYCoCg(c);
        mn = min(mn, yc);
        mx = max(mx, yc);
        m1 += yc;
        m2 += yc * yc;
        float dep = texelFetch(u_Depth, t, 0).r;
        if (dep >= 1.0)
            skyNear = true;
        if (dep < closest)
        {
            closest = dep;
            closestTex = t;
        }
        if (dep < 1.0 && dep > farthest)
        {
            farthest = dep;
            farTex = t;
        }
        if (u_HasMotionFlag == 1 && texelFetch(u_GNormal, t, 0).w >= 3.5)
        {
            moving = true;
            if (dep < movDepth)
            {
                movDepth = dep;
                movTex = t;
            }
        }
    }
    vec3 current = sum / max(wsum, 1e-4);
    // 309: hareket eden nesnenin temas kenarı (zeminde sürüklenen küpün alt kenarı): 3x3'ün en yakın örneği önündeki durağan zemin, küp
    // ondan yalnız birkaç santim geride. Kenar küple birlikte kayar: kesin hızlı nesne en yakın durağan örnekten temas payı kadar
    // gerideyse (durağan bir nesnenin arkasından geçmiyorsa) kenarın geçmişi nesnenin hareketiyle alınır (yerel TAA ile aynı)
    if (u_HasVelocity == 1 && movDepth < 1.0 && closest < movDepth)
    {
        vec4 sv = texelFetch(u_Velocity, closestTex, 0);
        vec4 mv = texelFetch(u_Velocity, movTex, 0);
        float wS = ViewW((vec2(closestTex) + 0.5) * u_InTexel, closest);
        if (sv.x >= 5000.0 && mv.x < 5000.0 && mv.z > 0.75 && ViewW((vec2(movTex) + 0.5) * u_InTexel, movDepth) - wS < 0.03 * wS + 0.05)
        {
            closest = movDepth;
            closestTex = movTex;
        }
    }
    // Yeniden izdüşüm: 3x3'ün en yakın derinliği (kenarda ön yüzün hareketi)
    vec2 closestUV = (vec2(closestTex) + 0.5) * u_InTexel;
    vec4 world = u_InvViewProj * vec4(closestUV * 2.0 - 1.0, closest * 2.0 - 1.0, 1.0);
    float curW = 1.0 / max(abs(world.w), 1e-8);   // görüş uzaklığı
    world /= world.w;
    vec4 prevClip = u_PrevViewProj * world;
    // Bakış yönü dönüşü (radyan / kare): kamera bir nesnenin etrafında dönerken yüzler döner, geçmişe güvenen yollar kapanır (TAA ile aynı)
    float viewTurn = (closest < 1.0 && u_CameraStill == 0) ? length(cross(normalize(world.xyz - u_CameraPos), normalize(world.xyz - u_PrevCameraPos))) : 0.0;
    vec2 velocity = (closestUV - u_JitterUV) - (prevClip.xy / prevClip.w * 0.5 + 0.5);
    if (u_CameraStill == 1 || prevClip.w <= 0.0)
        velocity = vec2(0.0);
    bool objectVelocity = false;
    bool exactObject = false;   // geçmiş hareket eden nesnenin kesin hızıyla izleniyor (nesnenin kendisi ya da kenarı)
    if (u_HasVelocity == 1)
    {
        vec4 ov = texelFetch(u_Velocity, closestTex, 0);
        if (ov.x < 5000.0)
        {
            velocity = ov.xy;
            objectVelocity = true;
            exactObject = ov.z > 0.75;
        }
    }
    // 309: yalnız hızı kesin bilinmeyen hareket (yaklaşık hızlı graph malzeme, durağan bir nesnenin arkasından geçen nesnenin kenarı)
    // az geçmişle çizilir. Eskiden 3x3'te hareket eden nesne olan her pikselin geçmiş ağırlığı %50'ye iniyordu: kesin hızla izlenen
    // sürüklenen küp her karede yarı yarıya tek titreşimli örnekten oluşuyor, kenarları merdivenli görünüyordu (yerel TAA'da kesin
    // hızlı nesne zaten normal yoldan gider)
    bool movingStrict = moving && !exactObject;
    // Pikselin kendi yüzeyi 3x3'ün en yakın yüzeyi mi (gökyüzü hiçbir zaman değil) ve iki yanı en yakın yüzeyle çevrili ince aralık mı
    // (küplerin arası: aralık ön yüzlerle birlikte kayar)
    bool onClosestSurface = cDepth < 1.0 && abs(cW - curW) < 0.03 * curW + 0.02;
    bool enclosedGap = false;
    if (closest < 1.0 && !onClosestSurface)
    {
        bool nr[8];
        const ivec2 axisOff[8] = ivec2[](ivec2(-1, 0), ivec2(1, 0), ivec2(0, 1), ivec2(0, -1), ivec2(2, 0), ivec2(-2, 0), ivec2(0, -2), ivec2(0, 2));
        for (int k = 0; k < 8; ++k)
        {
            ivec2 t = clamp(cTex + axisOff[k], ivec2(0), inMax);
            float ad = texelFetch(u_Depth, t, 0).r;
            nr[k] = ad < 1.0 && abs(ViewW((vec2(t) + 0.5) * u_InTexel, ad) - curW) < 0.02 * curW + 0.02;
        }
        // nr: 0 sol1, 1 sağ1, 2 üst1, 3 alt1, 4 sağ2, 5 sol2, 6 alt2, 7 üst2
        enclosedGap = ((nr[0] || nr[5]) && (nr[1] || nr[4])) || ((nr[2] || nr[7]) && (nr[3] || nr[6]));
    }
    vec2 prevUV = v_UV - velocity;
    if (u_HistoryValid == 0 || any(lessThan(prevUV, vec2(0.0))) || any(greaterThan(prevUV, vec2(1.0))))
    {
        FragColor = vec4(current, 0.0);
        if (u_Debug == 1)
            DebugOut = vec4(1.0);   // beyaz: geçmiş yok / ekran dışından
        return;
    }
    // Açılma: kendi noktasının kendi hareketiyle önceki karedeki yeri (en yakın derinliğin hareketi değil: küpün kenarındaki arka plan
    // pikseli küpün hareketini alıp geçmişini küpten çekiyor, yana yürürken küpün arkasında mavi iz kalıyordu)
    bool revealed = false;
    {
        vec4 cWorld = u_InvViewProj * vec4(cUV * 2.0 - 1.0, cDepth * 2.0 - 1.0, 1.0);
        cWorld /= cWorld.w;
        vec4 cPrev = u_PrevViewProj * cWorld;
        vec2 cNow = cUV - u_JitterUV;
        vec2 cPrevUV = cPrev.xy / cPrev.w * 0.5 + 0.5;
        float cPrevW = cPrev.w;
        if (u_HasVelocity == 1)
        {
            vec4 ov = texelFetch(u_Velocity, cTex, 0);
            if (ov.x < 5000.0)
            {
                cPrevUV = cNow - ov.xy;
                cPrevW = cW;
            }
        }
        // Gökyüzü pikselinde örtücü hâlâ yanındaysa (3x3'teki en yakın yüzey kadar uzak) en az 2 iç piksel kaymalı (baş sallanması)
        float nearW = closest < 1.0 ? ViewW((vec2(closestTex) + 0.5) * u_InTexel, closest) : 1e9;
        float occW = 1e9;
        float shiftPx = cPrev.w > 0.0 ? RevealShift(cNow, cPrevUV, cPrevW, inSize, occW) : -1.0;
        bool occluderAdjacent = cDepth >= 1.0 && occW >= nearW * 0.85 - 0.05;
        revealed = shiftPx >= (occluderAdjacent ? 2.0 : 1.0);
        // 335: ön yüzün kenarındaki arka plan pikseli (kendi yüzeyi en yakın yüzey değil; ince aralık hariç) geçmişini de kendi yüzeyinin
        // hareketiyle alır (açılma testi gibi). En yakın yüzeyin hareketiyle aldığında geçmiş ön yüzün eski yerinden, yani ön yüzün
        // renginden geliyordu: hızlı yana koşarken piramidin açtığı duvarda açılmadan sonraki karelerde mavi çizgiler ve eski silüet kalıyordu
        // Yalnız iki hareket en az 1 iç piksel ayrışınca (açılma testinin gördüğü hız): daha yavaş paralakste (zıplama) açılma görülmez,
        // kendi hareketiyle alınan geçmiş ön yüzün eski yerine düşer; en yakın yüzeyin hareketi ise kenarın hemen yanındaki aynı noktayı verir
        if (!onClosestSurface && !enclosedGap && u_CameraStill == 0 && cPrev.w > 0.0 && length(((cNow - cPrevUV) - velocity) * inSize) >= 1.0)
        {
            vec2 ownPrev = v_UV - (cNow - cPrevUV);
            if (all(greaterThanEqual(ownPrev, vec2(0.0))) && all(lessThanEqual(ownPrev, vec2(1.0))))
                prevUV = ownPrev;
        }
    }
    // Nesnenin ayrıldığı yer (324, TAA'daki 291 / 292 ile aynı): piksel şimdi durağan bir yüzeyde (nesne hızı yok) ve kendisi ya da 3x3
    // komşusu önceki karede bir nesnenin altındaydı (hareket vektörü geçişinde w = 2, orada şimdi nesne yok: kalkan / devrilen hedef
    // tahtasının eski yeri, silinen ya da sürüklenen nesnenin arkası). Geçmiş o nesnenin rengini taşır: atılır, birikim baştan başlar.
    // TAA + NIS'te (TAAU) vurulan hedef kalkarken arkasındaki duvarda tahtanın kenarlarından çizgi çizgi iz kalıyordu
    bool vacated = false;
    if (u_HasVelocity == 1)
    {
        ivec2 vsz = textureSize(u_Velocity, 0);
        ivec2 vc = clamp(ivec2((vec2(cTex) + 0.5) * u_InTexel * vec2(vsz)), ivec2(0), vsz - 1);
        // Kesin hızla izlenen kenar pikselinde önceki kapsama işareti aynı nesnenindir (geçmiş kenarın önceki yerinden gelir): atılmaz
        if (texelFetch(u_Velocity, vc, 0).x >= 5000.0 && !exactObject)
            for (int i = 0; i < 9 && !vacated; ++i)
            {
                vec4 nv = texelFetch(u_Velocity, clamp(vc + ivec2(i % 3 - 1, i / 3 - 1), ivec2(0), vsz - 1), 0);
                vacated = nv.w > 1.5 && nv.w < 2.5 && nv.x >= 5000.0;
            }
    }
    // 324: hareket eden nesnenin gölge hacmindeki durağan yüzey: gölge kayar, geçmiş tutulmaz / genişletilmiş kutuyla saklanmaz
    // (kalkan hedefin gölgesinin kenarı titreşim örnekleriyle noktalı kalıyordu); TAA'daki gölge kutusu yolu gibi sıkı kırpılır
    // 3x3'ün herhangi bir iç örneği gölge hacmindeyse (291): kenar pikselinde (duvar üstü ile ötedeki gölgeli zemin arası) merkez örnek
    // ötedeki yüzeye düşüyor, pikselin geçmişindeki silinen küpün gölgesi korunmuyor, komşulukta koyu zemin olduğu için kırpılmıyordu
    bool movingShadow = false;
    if (u_ShadowBoxCount > 0)
        for (int i = 0; i < 9 && !movingShadow; ++i)
        {
            ivec2 t = clamp(base + ivec2(i % 3 - 1, i / 3 - 1), ivec2(0), inMax);
            float sd = texelFetch(u_Depth, t, 0).r;
            if (sd >= 1.0)
                continue;
            vec4 wp = u_InvViewProj * vec4(((vec2(t) + 0.5) * u_InTexel) * 2.0 - 1.0, sd * 2.0 - 1.0, 1.0);
            movingShadow = InMovingShadow(wp.xyz / wp.w);
        }
    // 334 / 329: kenar paralaksı (yerel TAA'daki gibi). Kamera yer değiştirirken (zıplama, yana kayma) 3x3'teki en yakın ve en uzak
    // yüzey ekranda farklı hızda kayar; kenarın arka tarafı her karede biraz açılır ya da örtülür. Titreme tutması ve geniş kutu
    // (güvenilir yol) orada geçmişi kırpmadan yüksek ağırlıkla tuttuğundan kenar geride kalıyordu: zıplarken uzak duvarın üst kenarı
    // ve piramidin basamak köşeleri çift / hayalet kenar bırakıyordu (açılma testi 1 pikselden yavaş açılmayı ve %15'ten küçük derinlik
    // farkını görmüyor). İki hareket 0.06 çıktı pikselinden fazla ayrışırsa bu iki yol kapanır. İnce aralık (küplerin arası: iki yanı en
    // yakın yüzeyle, yani aynı uzaklıktaki ön yüzlerle çevrili) ön yüzlerle birlikte kayar, içi derin görünse de paralaks sayılmaz
    float parallaxPx = 0.0;
    if (closest < 1.0 && farthest > closest && !objectVelocity && u_CameraStill == 0)
    {
        vec2 farUV = (vec2(farTex) + 0.5) * u_InTexel;
        vec4 qb = u_InvViewProj * vec4(farUV * 2.0 - 1.0, farthest * 2.0 - 1.0, 1.0);
        vec4 pb = u_PrevViewProj * (qb / qb.w);
        if (pb.w > 0.0 && prevClip.w > 0.0)
            parallaxPx = length(((closestUV - (prevClip.xy / prevClip.w * 0.5 + 0.5)) - (farUV - (pb.xy / pb.w * 0.5 + 0.5))) / u_OutTexel);
    }
    if (parallaxPx >= 0.06)
    {
        float cwN = ViewW(closestUV, closest);
        bool nr[8];
        const ivec2 axisOff[8] = ivec2[](ivec2(-1, 0), ivec2(1, 0), ivec2(0, 1), ivec2(0, -1), ivec2(2, 0), ivec2(-2, 0), ivec2(0, -2), ivec2(0, 2));
        for (int k = 0; k < 8; ++k)
        {
            ivec2 t = clamp(cTex + axisOff[k], ivec2(0), inMax);
            float ad = texelFetch(u_Depth, t, 0).r;
            nr[k] = ad < 1.0 && abs(ViewW((vec2(t) + 0.5) * u_InTexel, ad) - cwN) < 0.02 * cwN + 0.02;
        }
        // nr: 0 sol1, 1 sağ1, 2 üst1, 3 alt1, 4 sağ2, 5 sol2, 6 alt2, 7 üst2
        bool enclosed = ((nr[0] || nr[5]) && (nr[1] || nr[4])) || ((nr[2] || nr[7]) && (nr[3] || nr[6]));
        if (enclosed)
            parallaxPx = 0.0;
    }
    // Geçmişin geldiği yerin önceki kare derinliği beklenen uzaklıkla uyuşmuyorsa (geçmiş başka bir yüzeyin: açılan / örtülen kenar)
    // geçmişe güvenilmez (yerel TAA geçmişte saklanan derinlikle aynı denetimi yapar). Önceki derinliğin 2x2 ayak izinden biri uyması
    // yeter (titreşim konumu farkı)
    bool historyDepthOk = true;
    if (u_HasPrevDepth == 1 && u_CameraStill == 0 && !objectVelocity && closest < 1.0 && prevClip.w > 0.0)
    {
        ivec2 psz = textureSize(u_PrevDepth, 0);
        vec2 pp = prevUV * vec2(psz) - 0.5;
        ivec2 p0 = ivec2(floor(pp));
        // Tolerans: uzaklığın %3'ü + yüzeyin iç piksel başına uzaklık değişimi x 1.5 (eğik bakılan zeminde komşu satırlar arası metrelerce
        // fark olabilir; önceki derinlik bir önceki karenin titreşim konumunda örneklendi)
        float slopeW = farthest > closest ? 0.5 * (ViewW((vec2(farTex) + 0.5) * u_InTexel, farthest) - curW) : 0.0;
        float tolW = 0.03 * prevClip.w + 0.02 + 1.5 * slopeW;
        historyDepthOk = false;
        for (int k = 0; k < 4; ++k)
        {
            ivec2 pt = clamp(p0 + ivec2(k & 1, k >> 1), ivec2(0), psz - 1);
            float pd = texelFetch(u_PrevDepth, pt, 0).r;
            float pw = pd >= 1.0 ? 1e9 : ViewW((vec2(pt) + 0.5) / vec2(psz), pd);
            historyDepthOk = historyDepthOk || abs(pw - prevClip.w) < tolW;
        }
    }
    bool parallaxEdge = parallaxPx >= 0.06;
    bool velAmbiguous = parallaxEdge || !historyDepthOk;
    vec3 history = SampleHistory(prevUV);
    // Geçmişin alfası durum: 64 x (2 x biriken örnek ağırlığı, 0..31) + 2 x titreme puanı (0..16) + geçmiş geçen karede kutunun dışındaydı
    vec2 outSize = 1.0 / u_OutTexel;
    float stateBefore = max(texelFetch(u_History, clamp(ivec2(prevUV * outSize), ivec2(0), ivec2(outSize) - 1), 0).a, 0.0);
    float accBefore = floor(stateBefore / 64.0 + 1e-3);
    float lowBefore = stateBefore - 64.0 * accBefore;
    accBefore *= 0.5;
    float flickerBefore = floor(lowBefore * 0.5 + 1e-3);
    bool outsideBefore = lowBefore - 2.0 * flickerBefore > 0.5;
    bool reactive = false;
    if (u_HasReactive == 1)
        reactive = texelFetch(u_Reactive, clamp(base, ivec2(0), inMax), 0).r > 0.02;
    // Varyans kırpması (ortalama ± 1.25 sapma ∩ min / max), kanal kanal
    vec3 mean = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
    vec3 lo = max(mean - 1.25 * sigma, mn);
    vec3 hi = min(mean + 1.25 * sigma, mx);
    vec3 historyY = RGBToYCoCg(history);
    // Titreme tutması (TAA'daki gibi): pikselden ince ayrıntı (küplerin arası) titreşimin yalnız bazı karelerinde düşük çözünürlüklü
    // örneğe denk gelir; geçmiş karede bir kutunun içinde karede bir dışında kalır. Böyle aralıklı sapan piksel kırpılmaz (yürürken
    // yanıp sönüyordu); bir kez değişen ya da hep dışarıda kalan geçmiş kırpılır
    bool outsideNow = any(lessThan(historyY, lo - vec3(0.01))) || any(greaterThan(historyY, hi + vec3(0.01)));
    // Gökyüzüne bakan siluette tutulmaz: kenar kayarken geçmiş tutulunca uzak duvarın üstü basamaklı kalıyordu
    // Gölge hacminde yalnız ışığı gerçekten değişen piksel (geçmişi bu karenin aralığının dışında: silinen küpün gölgesi kalkan zemin)
    // hızlı güncellenir. Eskiden hacimdeki her piksel 8 kare zayıf birikimle çiziliyordu: hacim güneş yönüne uzanıp duvarı kapladığı
    // için silmeden sonra duvarın karo çizgileri ve üst kenarı titreyip beyaz çizgiler olarak görünüyordu (291)
    bool shadowChanged = movingShadow && outsideNow;
    float flicker = (moving || reactive || skyNear || vacated || shadowChanged) ? 0.0 : clamp(flickerBefore - 1.0 + ((outsideNow != outsideBefore) ? 6.0 : 0.0), 0.0, 16.0);
    if (velAmbiguous)
        flicker = 0.0;   // yerel TAA gibi: kenar paralaksında / tutarsız geçmişte titreme sayacı baştan başlar
    // Yalnız ince çizgi tutulur: bu karenin 3x3'ü düzgün (ayrıntı bu karede ıskalandı) ya da geçmiş kutunun aralığından çok
    // dışarıda. İki büyük yüzeyin kenarında (duvarın zemine değdiği yer) 3x3 iki rengi de içerir; orada basamak deseni kayarken
    // tutulunca kenar basamaklı kalıyordu
    float rangeY = mx.x - mn.x;
    float excessY = max(max(lo.x - historyY.x, historyY.x - hi.x), 0.0);
    // Genç piksel (açıldıktan sonraki birkaç kare: biriken ağırlık 4'ün altında) tutulmaz, güvenilir yola girmez: ilk karenin titreşimli
    // değeri geniş kutu ve yüksek ağırlıkla kalıyor, küpün arkasında açılan gökyüzünde / duvarda dikey tarak deseni bırakıyordu
    bool young = u_CameraStill == 0 && accBefore < 3.99;
    // Tutulan, kaçırılmış ince parlaklık ayrıntısıdır (küplerin arası, duvar çizgisi): komşulukla aynı tondadır. Geçmişin tonu (Co / Cg) bu
    // karenin 3x3 ton aralığının dışındaysa bu başka bir yüzeyin bulaşmış rengidir, tutulmaz (335: hızlı yana koşarken piramidin açtığı
    // duvarda mavi dikey çizgiler kalıyordu)
    bool foreignTone = any(lessThan(historyY.yz, mn.yz - vec2(0.03))) || any(greaterThan(historyY.yz, mx.yz + vec2(0.03)));
    bool hold = flicker >= 8.0 && (rangeY < 0.06 || excessY > rangeY) && viewTurn < 0.008 && !young && !vacated && !velAmbiguous && !foreignTone;
    // Yavaş kayan güvenilir yüzey (ileri geri yürürken küplerin arası, TAA'daki güvenilir yol): kırpma kutusu geniş, geçmişin ağırlığı
    // yüksek; dar kutu ıskalanan karelerde ince aralığı kırpıp geri yürürken yanıp söndürüyordu
    float speedPx = length(velocity * inSize);
    // Geniş kutu yalnız pikselin kendi yüzeyi 3x3'ün en yakın yüzeyiyse (329): ön yüzün kenarındaki arka plan pikselinin (küpün yanındaki
    // gökyüzü / duvar) geçmişi ön yüzün hareketiyle, yani ön yüzün eski yerinden gelir; geniş kutu bu rengi kırpmıyor, yana yürürken
    // küpün arkasında gökyüzünde soluk çizgiler kalıyordu
    // Gökyüzü hiç güvenilir yola girmez (yerel TAA gibi; onClosestSurface gökyüzünde yanlış): küpün kenarı geçerken gökyüzü pikseline
    // bulaşan renk küp uzaklaşınca geniş kutu ve %96 ağırlıkla yavaş sönüyor, yana yürürken küpün arkasındaki bulutlarda dikey tarak kalıyordu
    float slowTrust = (moving || reactive || objectVelocity || shadowChanged || u_CameraStill == 1 || young || !historyDepthOk || !onClosestSurface) ? 0.0 : (1.0 - smoothstep(1.5, 3.0, speedPx)) * (1.0 - smoothstep(0.003, 0.006, viewTurn));
    // Kamera duruyorken: geçmiş her karede bu düşük çözünürlüklü 3x3'ün aralığına kırpılınca çıktı çözünürlüğünde biriken ayrıntı
    // siliniyordu (yükseltme bulanık kalıyordu). Kutu küçük bir payla genişler (büyük değişim, namlu alevi ışığı yine kırpılır)
    bool settle = u_CameraStill == 1 && !moving && !reactive && !shadowChanged;
    vec3 historyBeforeClamp = history;
    if (!hold)
    {
        vec3 pad = settle ? vec3(0.06, 0.03, 0.03) : vec3(0.0);
        history = YCoCgToRGB(clamp(historyY, mix(lo - pad, mean - 2.5 * sigma, slowTrust), mix(hi + pad, mean + 2.5 * sigma, slowTrust)));
    }
    // Hızlı harekette ve hareket eden nesnede geçmişe daha az güven; çıktı pikselinin yakınında örnek yoksa az güncelleme
    float speed = length(velocity * inSize);
    float feedback = mix(u_Feedback, 0.7, clamp(speed / 16.0, 0.0, 1.0));
    // Dururken: kamera durduğundan beri gelen örneklerin ağırlıklı ortalaması (her örneğin ağırlığı çıktı pikseline yakınlığı,
    // biriken ağırlık en çok 15.5). Oyun başlarken / durunca geçmiş yarım saniyede bu konumun ortalamasına oturur. Eskiden güncelleme
    // sabit 0.96 x yakınlıktı: yakınına örnek düşmeyen çıktı pikselleri 2 saniye boyunca yavaşça değişiyordu (küplerin arası başta
    // açık, bir iki saniye sonra koyu). Hareket ederken geçmiş 4 örnek değerinde sayılır (durunca ilk kare tek titreşimli kareye atlamaz)
    float acc = 4.0;
    float alphaSettle = -1.0;
    // 292: kamera dururken geçmişi yeni sıfırlanan (nesnenin ayrıldığı / açılan) piksel de dar süzgeç ve en yakın iç örneğin ağırlığıyla
    // birikiyordu: ilk karelerde her çıktı pikseli yalnız kendine en yakın düşük çözünürlüklü örneği gösteriyor, bölge noktalı / taramalı
    // ve kenarları basamaklı görünüyordu (önizleme küpü duvarın üstünden çekilince duvar üstünün kenarı). Hareket ederken genç pikseldeki
    // gibi (329): ilk 4 örnek geniş süzgeçle ve her çıktı pikselinde aynı ağırlıkla (1/2, 1/3, 1/4), sonra dar süzgeçle birikim sürer
    vec3 currentWide = current;
    bool settleYoung = settle && accBefore < 3.99;
    if (settle && !settleYoung)
    {
        current = sumN / max(wsumN, 1e-4);
        alphaSettle = wmaxN / (min(accBefore, 15.5) + wmaxN);
        acc = min(accBefore + wmaxN, 15.5);
    }
    else if (settleYoung)
    {
        alphaSettle = 1.0 / (accBefore + 1.0);
        acc = min(accBefore + 1.0, 4.0);
    }
    if (hold)
        feedback = max(feedback, 0.94);
    feedback = mix(feedback, max(feedback, 0.96), slowTrust);
    if (movingStrict || reactive)
        feedback = min(feedback, 0.5);
    // Yaklaşırken geçmiş bu kareden düşük çözünürlüklüdür (TAA ile aynı ilke): ağırlık büyütme oranıyla sınırlı
    // Görüş açısı daralınca (sağ tık nişan, dürbün) görüntü odak uzaklığı oranında büyür
    float magnify = (u_CameraStill == 0 && closest < 1.0 && !objectVelocity) ? max(prevClip.w / curW * u_ProjScale - 1.0, 0.0) : 0.0;
    if (magnify > 0.0)
        feedback = min(feedback, 0.12 / (0.12 + magnify));
    float alpha = alphaSettle >= 0.0 ? max(alphaSettle, 0.02) : max((1.0 - feedback) * wmax, 0.02);
    // Genç piksel eşit ağırlıklı birikir (her örnek çıktı pikseline yakınlığıyla): birkaç karede titreşim konumlarının ortalamasına oturur
    if (young && alphaSettle < 0.0)
    {
        // Ağırlık en yakın iç örneğin uzaklığına (wmax) bağlı değil, her çıktı pikselinde aynı (329): büyütmede çıktı sütunları iç
        // örneklere dönüşümlü yakın / uzak düşer, wmax ağırlığıyla açılan gökyüzü / duvar sütun sütun farklı hızda oturup küpün
        // arkasında dikey tarak deseni bırakıyordu (yana yürürken mavi küplerin izi)
        alpha = max(alpha, 1.0 / (accBefore + 1.0));
        acc = min(accBefore + 1.0, 4.0);
    }
    // Hacimde ışığı az değişen piksel (eski gölgenin sınırı, kırpma kutusunun içinde kalan fark): titreme koruması ve dar süzgeç
    // korunur, yalnız birikim biraz hızlanır (yoksa sınır 20 kare koyu kalıyordu)
    if (movingShadow && !shadowChanged && !vacated)
        alpha = max(alpha, 0.2);
    if (shadowChanged && !vacated)
    {
        // 291: hareket eden / silinen nesnenin gölge hacmi: hacim sürdükçe (silinen düşürücüde 8 kare) bu kare en az yarı ağırlıkla
        // girer, kalıntı birkaç karede silinir. Yalnız kırpma sıkılaşınca kenar pikselinde (duvar üstü ile ötedeki gölgeli zemin) silinen
        // küpün gölgesi geçmişte kalıyor, yüksek birikim ağırlığıyla yarım saniye ince koyu çizgi olarak sönüyordu. Birikim ağırlığı
        // sıfırlanmaz: hacim bitince "kamera dururken" yolu dar süzgeçli tek kareye yüksek ağırlık verip kenarı noktalı gösteriyordu
        alpha = max(alpha, 0.5);
        flicker = 0.0;
    }
    if (vacated)
    {
        // Nesnenin bıraktığı geçmiş atılır: bu karenin örneği (geniş süzgeçle), birikim yeniden başlar (genç piksel olarak eşit ağırlıkla
        // oturur)
        history = currentWide;
        current = currentWide;
        alpha = 1.0;
        acc = 1.0;
        flicker = 0.0;
    }
    else if (revealed)
    {
        // Geçmiş örtücünündür: atılır, bu karenin (geniş süzgeçli, yumuşak) değeriyle başlanır; sonraki karelerde genç piksel olarak
        // eşit ağırlıkla oturur. Eskiden örtücünün rengi kendi yüzeyinin aralığına kırpılıp %40 tutuluyordu: kırpılan renk (mavi küp ->
        // gökyüzü aralığı) yanlış tonda kalıp açılan alanda çizgi çizgi görünüyordu
        history = currentWide;
        current = currentWide;
        alpha = 1.0;
        acc = 1.0;
        flicker = 0.0;
    }
    FragColor = vec4(max(mix(history, current, alpha), vec3(0.0)), floor(acc * 2.0) * 64.0 + flicker * 2.0 + (outsideNow ? 1.0 : 0.0));
    if (u_Debug == 1)
    {
        // Pembe: nesnenin ayrıldığı yer, turuncu: açılan alan, altın: hareketli gölgede ışığı değişen, kırmızı: hareket eden nesne /
        // tepki maskesi, koyu kırmızı: nesne hızı, açık yeşil: titreme tutması, yeşil: kamera duruyor, mor: genç piksel, mavi: yavaş
        // ve güvenilir (geniş kutu), eflatun: gökyüzü komşusu, sarı: normal kırpma (parlak: geçmiş kırpıldı, koyu: kırpılmadı)
        vec3 tint;
        bool clamped = distance(RGBToYCoCg(historyBeforeClamp), RGBToYCoCg(history)) > 0.02;
        if (vacated) tint = vec3(1.0, 0.4, 0.6);
        else if (revealed) tint = vec3(1.0, 0.5, 0.0);
        else if (shadowChanged) tint = vec3(1.0, 0.8, 0.0);
        else if (movingStrict || reactive) tint = vec3(1.0, 0.0, 0.0);
        else if (objectVelocity) tint = vec3(0.5, 0.0, 0.0);
        else if (velAmbiguous) tint = vec3(0.0, 1.0, 1.0) * (clamped ? 1.0 : 0.55);   // camgöbeği: paralaks belirsiz kenar
        else if (hold) tint = vec3(0.5, 1.0, 0.6);
        else if (settle) tint = vec3(0.0, 1.0, 0.0) * (clamped ? 1.0 : 0.6);
        else if (young) tint = vec3(0.6, 0.2, 1.0);
        else if (slowTrust > 0.5) tint = vec3(0.1, 0.3, 1.0) * (clamped ? 1.0 : 0.55);
        else if (skyNear) tint = vec3(1.0, 0.0, 1.0) * (clamped ? 1.0 : 0.55);
        else tint = vec3(1.0, 1.0, 0.0) * (clamped ? 1.0 : 0.55);
        float l = clamp(dot(FragColor.rgb, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0);
        DebugOut = vec4(mix(vec3(l), tint, 0.65), 1.0);
    }
}
