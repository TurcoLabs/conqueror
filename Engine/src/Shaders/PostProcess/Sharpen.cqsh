#language GLSL
// Son geçiş: kopya (+ isteğe bağlı kontrast uyarlamalı keskinleştirme, AMD CAS benzeri)
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
out vec2 v_UV;
void main()
{
    v_UV = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core
layout(location = 0) out vec4 FragColor;
in vec2 v_UV;
uniform sampler2D u_ScreenTexture;
uniform vec2 u_InverseScreenSize;
uniform float u_Amount = 0.0;
// TAA durumu (z: durgunluk yaşı 0..31 + 32 x titreme bilgisi): kamera hareket ederken geçmiş her karede piksel altı kaymayla
// yeniden örneklenip yumuşar; hareketteki ve duruştan sonraki ilk karelerde (yeniden birikim keskinleştirene kadar) keskinlik artar
uniform sampler2D u_MotionState;
uniform int u_HasMotionState = 0;
uniform float u_MotionAmount = 0.0;
// 341: çekirdek ağırlığının çarpanı (1: değişmez). Miktar ağırlığı 0.125 ile 0.2 arasında seçer; sıfıra inen bir sönüş son karede tam
// ağırlıktan sıfıra düşüyordu, çarpan onu sürekli sıfıra indirir
uniform float u_WeightScale = 1.0;
// 330: TAA + NIS / FSR 1 / CAS (uzamsal keskinleştirici TAAU'dan sonra): geometrik kenarda (iç çözünürlükte 3x3'te derinlik kesintisi ya
// da normal kıvrımı) keskinleştiricinin çıktısı yerine TAAU'nun keskinleştirilmemiş çıktısı. TAAU kenarındaki piksel altı basamaklar
// (yerel TAA kadar: rampanın kenarında düz çizgiden ortalama 0.14 piksel) keskinleştirmeyle 0.20'ye büyüyor, kenarlar merdivenli
// görünüyordu; doku ayrıntısı (kenar olmayan her yer) keskinleştirilmiş kalır
uniform sampler2D u_Unsharpened;
uniform int u_HasUnsharpened = 0;
uniform sampler2D u_EdgeMask;     // EdgeMask.cqsh: geometrik kenar (0..1), kamera dururken zamanla biriktirilmiş
uniform float u_EdgeAmount = 0.0; // kenarlardaki keskinleştirilmemiş görüntünün keskinliği (yerel TAA'nın TAA Sharpness'ı)

// Kenara dik yönde keskinleştirme: parlaklık gradyanı yönünde iki komşuyla (CAS ağırlığıyla). Kenar boyunca örnek alınmaz: iç
// çözünürlükten kalan basamak deseni (kenar boyunca değişen parlaklık) büyütülmez, yalnız kenarın iki yanı arasındaki fark artar
vec3 SharpenAcross(sampler2D tex, float amount)
{
    vec3 c = texture(tex, v_UV).rgb;
    if (amount <= 0.0)
        return c;
    vec2 t = u_InverseScreenSize;
    const vec3 lw = vec3(0.2126, 0.7152, 0.0722);
    float l[9];
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x)
            l[(y + 1) * 3 + (x + 1)] = dot(texture(tex, v_UV + vec2(x, y) * t).rgb, lw);
    vec2 g = vec2((l[2] + 2.0 * l[5] + l[8]) - (l[0] + 2.0 * l[3] + l[6]), (l[6] + 2.0 * l[7] + l[8]) - (l[0] + 2.0 * l[1] + l[2]));
    float gl = length(g);
    if (gl < 1e-4)
        return c;
    vec2 n = g / gl;
    vec3 a = texture(tex, v_UV + n * t).rgb;
    vec3 b = texture(tex, v_UV - n * t).rgb;
    vec3 mn = min(c, min(a, b));
    vec3 mx = max(c, max(a, b));
    vec3 amp = sqrt(clamp(min(mn, 1.0 - mx) / max(mx, vec3(1e-4)), 0.0, 1.0));
    float edgeFade = 1.0 - smoothstep(0.15, 0.35, dot(mx - mn, lw));
    vec3 wgt = -amp * 2.0 * mix(0.125, 0.2, clamp(amount, 0.0, 1.0)) * edgeFade;
    return clamp((c + (a + b) * wgt) / (1.0 + 2.0 * wgt), mn, mx);
}

void main()
{
    vec3 c = texture(u_ScreenTexture, v_UV).rgb;
    if (u_HasUnsharpened == 1)
    {
        // Geometrik kenarda uzamsal keskinleştiricinin (NIS / FSR 1 / CAS) yerine TAAU'nun kendi çıktısı (330 / 314: NIS siluetlerde
        // merdiven çıkarıyordu). Normal kırığında ve ince aralıkta (g: küplerin birleştiği yer) yerel TAA'daki kadar (TAA Sharpness)
        // kenara dik yönde keskinleştirilir (286: hiç keskinleştirme yokken uzaktaki küplerin arası yerel TAA'dakinden soluk kalıyordu);
        // derinlik silueti keskinleşmez
        vec2 em = texture(u_EdgeMask, v_UV).rg;
        if (em.r > 0.0)
        {
            vec3 u = (em.g > 0.0 && u_EdgeAmount > 0.0) ? SharpenAcross(u_Unsharpened, u_EdgeAmount * em.g) : texture(u_Unsharpened, v_UV).rgb;
            c = mix(c, u, em.r);
        }
    }
    float amount = u_Amount;
    if (u_HasMotionState == 1 && u_MotionAmount > 0.0)
    {
        float stillAge = mod(max(texture(u_MotionState, v_UV).z, 0.0), 32.0);
        amount += u_MotionAmount * (1.0 - clamp(stillAge / 8.0, 0.0, 1.0));
    }
    else if (u_HasMotionState == 2)
        amount += u_MotionAmount;   // TAAU: piksel durumu yok, kamera bu karede kıpırdadıysa tüm görüntüde
    if (amount <= 0.0 || u_WeightScale <= 0.0)
    {
        FragColor = vec4(c, 1.0);
        return;
    }
    vec2 t = u_InverseScreenSize;
    vec3 n = texture(u_ScreenTexture, v_UV + vec2(0.0, t.y)).rgb;
    vec3 s = texture(u_ScreenTexture, v_UV - vec2(0.0, t.y)).rgb;
    vec3 e = texture(u_ScreenTexture, v_UV + vec2(t.x, 0.0)).rgb;
    vec3 w = texture(u_ScreenTexture, v_UV - vec2(t.x, 0.0)).rgb;
    vec3 mn = min(c, min(min(n, s), min(e, w)));
    vec3 mx = max(c, max(max(n, s), max(e, w)));
    vec3 amp = clamp(min(mn, 1.0 - mx) / max(mx, vec3(1e-4)), 0.0, 1.0);
    amp = sqrt(amp);
    // Sert geometri kenarında (duvar üstü / gökyüzü, nesne silueti: yerel kontrast 0.35 üstü) keskinleştirme yapılmaz: TAA'nın
    // yumuşattığı kenarı yeniden basamaklandırıp 5-6 metreden "dikenli" gösteriyordu. Orta kontrastlı ince ayrıntı (uzaktaki
    // basamak çizgisi, küplerin arası: 0.1-0.25) keskinleşir; eskiden 0.06'dan itibaren kesildiği için uzak ayrıntı yumuşak kalıyordu
    float lumRange = dot(mx - mn, vec3(0.2126, 0.7152, 0.0722));
    float edgeFade = 1.0 - smoothstep(0.15, 0.35, lumRange);
    vec3 wgt = -amp * mix(0.125, 0.2, clamp(amount, 0.0, 1.0)) * edgeFade * u_WeightScale;
    vec3 result = (c + (n + s + e + w) * wgt) / (1.0 + 4.0 * wgt);
    // Hale yok: sonuç komşuluğun aralığında kalır. Keskin kenarda (duvar üstü / gökyüzü) eksi ağırlıklar kenarın bir yanında
    // koyu, öbür yanında parlak çizgi üretiyordu; kamera hareket ederken bu çizgi kenarı merdivenli gösteriyordu
    FragColor = vec4(clamp(result, mn, mx), 1.0);
}
